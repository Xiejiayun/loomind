{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loomind",
  "main": "./worker/auth.ts",
  "account_id": "9198bde6a94accd267e7ead951ed037e",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "vars": {
    "AUTH_ORIGIN": "https://loomind.jeremyxie.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGSMsKL2gyj9cijh",
    "AI_FREE_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "PRO_LLM_MODEL": "gpt-6.2-sol",
    "AI_FREE_DAILY_LIMIT": "3",
    "AI_FREE_IP_DAILY_LIMIT": "30",
    "AI_PRO_DAILY_LIMIT": "100",
    "AI_ALLOW_MOCK": "true"
  },
  "ai": {
    "binding": "AI"
  },
  "secrets": {
    "required": ["GOOGLE_CLIENT_ID", "TURNSTILE_SECRET", "SESSION_SECRET"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "loomind", "database_id": "20f4062e-5a50-46f1-b74b-c48acc0e1ad4", "migrations_dir": "migrations" }
  ],
  "routes": [
    { "pattern": "loomind.jeremyxie.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
