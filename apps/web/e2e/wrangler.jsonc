{
  "name": "loomind-browser-test",
  "main": "../worker/auth.ts",
  "compatibility_date": "2026-11-24",
  "dev": { "local_protocol": "https" },
  "ratelimits": [{ "name": "WEB_SOURCE_LIMIT", "namespace_id": "741932", "simple": { "limit": 10, "period": 60 } }],
  "assets": { "directory": "../dist", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "temporary-browser-drafts", "database_id": "00000000-0000-4000-8000-000000000002", "migrations_dir": "../migrations" }
  ]
}
